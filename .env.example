# PostgreSQL: credenciales separadas para que cada componente sea visible.
# Ajusta estos valores a tu instalación local.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=helpdesk
DB_USER=postgres
DB_PASSWORD=postgres

# Clave usada para firmar y validar JWT.
# En un proyecto real debe ser larga, aleatoria y mantenerse fuera del repositorio.
JWT_SECRET=change-this-development-secret

# Puerto HTTP de Express.
PORT=3000

# Opcional: URL que usará el CLI para consumir la API.
# Si se omite, el CLI usa http://localhost:<PORT>.
# API_URL=http://localhost:3000
